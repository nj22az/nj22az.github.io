  "uppgift": {
    "fraga": "En armatur i ett kylrum ombord ska bytas. Den matas från en grupp i en fördelning och har ett inbyggt nödljusbatteri. Golvet är fuktigt.",
    "delfragor": [
      {
        "id": "a",
        "text": "Fyll i riskbedömningen: fara, händelse, konsekvens, befintliga skydd och åtgärder."
      },
      {
        "id": "b",
        "text": "Välj arbetsmetod och motivera valet."
      },
      {
        "id": "c",
        "text": "Skriv vem som gör vad och hur varje åtgärd verifieras."
      },
      {
        "id": "d",
        "text": "Vilken energikälla är lätt att missa?"
      }
    ],
    "svarsformat": "Ifylld mall med spårbara åtgärder."
  },
