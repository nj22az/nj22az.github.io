  "uppgift": {
    "fraga": "12 V matar 1 kΩ i serie med 2 kΩ. Utgången tas över 2 kΩ. En last på 2 kΩ kopplas över utgången. Bestäm utspänningen.",
    "samband": [
      "R_{p} = R_{2} · R_{last}/(R_{2} + R_{last})",
      "U_{ut} = U_{in} · R_{p}/(R_{1} + R_{p})"
    ],
    "givet": "U_{in} = 12 V, R_{1} = 1 kΩ, R_{2} = 2 kΩ, R_{last} = 2 kΩ. Utspänningen tas över parallellgruppen.",
    "instruktion": "+"
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "R_{p} är ersättningsresistansen för R_{2} och lasten parallellt. Räkna alla resistanser i samma enhet.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Ersätt R_{2} och lasten med R_{p} och använd sedan delningsformeln med R_{p} som nedre resistor.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "Rp = 2 · 2/(2 + 2) = 1 kΩ. Uut = 12 · 1/(1 + 1) = 6,0 V. Utan last hade det varit 8,0 V.",
    "svar": [
      {
        "storhet": "U_{ut}",
        "varde": 6.0,
        "avrundning": "heltal",
