  "uppgift": {
    "fraga": "4,0 A och 1,5 A går in i en nod. 2,0 A och I_{x} går ut. Bestäm I_{x}.",
    "samband": [
      "ΣI_{in} = ΣI_{ut}"
    ],
    "givet": "4,0 A och 1,5 A in, 2,0 A och I_{x} ut. Alla riktningar är givna.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "Strömmen in i noden är lika med strömmen ut.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Skriv upp ekvationen, lägg ihop strömmarna in och dra bort den kända strömmen ut.",
      "status": "migrerad"
    }
  ],
  "losning": {
