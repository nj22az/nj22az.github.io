    {
      "niva": "begrepp",
      "text": "u(t) är spänningen vid en viss tidpunkt. Vinkeln 2πft är i radianer, så räknaren ska stå i RAD.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna först vinkeln, sedan sinus, och multiplicera sist med toppvärdet.",
