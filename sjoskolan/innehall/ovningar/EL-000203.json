  "uppgift": {
    "fraga": "Ett isolationsprov med 500 V ger en stabil läckström på 0,25 mA. Beräkna isolationsresistansen.",
    "samband": [
      "R = Uprov/Iläck"
    ],
    "givet": "Isolationen räknas som en ren resistans: 500 V och 0,25 mA. Uppgiften är bara en beräkning.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "1 mA = 0,001 A och 1 MΩ = 1 000 000 Ω.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Gör om läckströmmen till A, dela spänningen med strömmen och gör om svaret till MΩ.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "R = 500/0,00025 = 2 000 000 Ω = 2,0 MΩ.",
