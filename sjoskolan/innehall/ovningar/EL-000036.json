  "uppgift": {
    "fraga": "Två kopparledare, vardera 10 m, har arean 2,5 mm². Använd ρ = 0,0175 Ω·mm²/m. Beräkna slingresistansen.",
    "samband": [
      "R = ρ · ltotal/A; ltotal = 2 · lenkel"
    ],
    "givet": "Koppar vid 20 °C: ρ = 0,0175 Ω·mm²/m. Två ledare à 10 m. Kontaktresistans försummas.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "ρ är resistivitet i Ω·mm²/m, l längd i m och A ledararea i mm².",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Lägg ihop fram- och återledarens längd. Sätt in den totala längden och arean 2,5 mm².",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "R = 0,0175 · 20 m / 2,5 mm² = 0,14 Ω.",
