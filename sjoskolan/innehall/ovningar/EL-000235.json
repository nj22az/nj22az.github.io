  "uppgift": {
    "fraga": "R = 30 Ω och XL = 40 Ω i serie över 100 V RMS. Bestäm I och cos φ.",
    "samband": [
      "|Z| = √(R² + XL²)",
      "I = U/|Z|; cos φ = R/|Z|"
    ],
    "givet": "RL i serie: R = 30 Ω, XL = 40 Ω och U = 100 V RMS.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "R är den resistiva och XL den induktiva delen av impedansen. U och I är effektivvärden.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna ut impedansen och använd den för både ström och effektfaktor.",
