  "uppgift": {
    "fraga": "U_{L} = 400 V i ett symmetriskt system. Beräkna U_{F}.",
    "samband": [
      "U_{F} = U_{L}/√3"
    ],
    "givet": "Symmetrisk trefaskälla med U_{L} = 400 V. √3 ≈ 1,732.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "U_{L} är linjespänningen (huvudspänningen) mellan två faser. U_{F} är spänningen mellan en fas och neutralpunkten.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Dela linjespänningen med √3 och skriv tydligt att svaret gäller mellan fas och neutral.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "U_{F} = 400/1,732 ≈ 231 V mellan fas och neutral.",
    "svar": [
      {
        "storhet": "U_{F}",
        "varde": 231.0,
        "avrundning": "heltal",
