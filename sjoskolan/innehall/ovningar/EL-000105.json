  "uppgift": {
    "fraga": "Samma last som i uppgift 4 är induktiv och sinusformad. Beräkna S och Q.",
    "samband": [
      "S = √3 U_{L}I_{L} Q = S sin φ",
      "sin φ = √(1 − cos²φ)"
    ],
    "givet": "U_{L} = 400 V, I_{L} = 10 A, cos φ = 0,80. Symmetrisk last med rena sinussignaler.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "S är den totala skenbara effekten i VA och Q den reaktiva effekten i var, positiv för induktiv last.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna ut S och sin φ var för sig, multiplicera och gör om till kVA och kvar.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "S ≈ 6,93 kVA. sin φ = 0,60. Q ≈ 4,16 kvar.",
    "svar": [
