  "uppgift": {
    "fraga": "Instrumentet visar 100,0 V. Specifikationen är ±(0,5 % + 2 siffror) och upplösningen 0,1 V. Beräkna felgränsen och intervallet.",
    "samband": [
      "δ = (a/100) · visning + n · steg",
      "Intervall: visning − δ till visning + δ"
    ],
    "givet": "Visat värde 100,0 V, a = 0,5, n = 2 och steg = 0,1 V.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "a är procenttalet, n antalet siffror, steg upplösningen och δ den totala felgränsen.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna de två delarna var för sig, lägg ihop dem och räkna ut intervallets båda gränser.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "δ = 0,5 V + 0,2 V = 0,7 V. Intervall 99,3–100,7 V.",
