  "uppgift": {
    "fraga": "R = 60 Ω och XC = 80 Ω i serie över 200 V RMS. Bestäm |Z|, I och φ.",
    "samband": [
      "X = −XC; |Z| = √(R² + X²)",
      "I = U/|Z|; φ = arctan(X/R)"
    ],
    "givet": "RC i serie: R = 60 Ω, XC = 80 Ω, U = 200 V RMS. Räknaren står i grader (DEG)."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "Kapacitiv reaktans räknas negativ, och negativ φ betyder att strömmen ligger före spänningen.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Använd X = −80 Ω. Räkna impedans, ström och vinkel i den ordningen.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "|Z| = 100 Ω, I = 2,0 A, φ = arctan(−80/60) ≈ −53,1°. Strömmen leder spänningen.",
    "svar": [
