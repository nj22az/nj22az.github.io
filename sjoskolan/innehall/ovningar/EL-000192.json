  },
  "uppgift": {
    "fraga": "En symmetrisk trefaslast tar P = 1,0 MW vid U_{L} = 6,6 kV och PF = 0,90. Beräkna linjeströmmen.",
    "samband": [
      "I_{L} = P/(√3 · U_{L} · PF)"
    ],
    "givet": "Symmetrisk last: P = 1,0 MW, U_{L} = 6,6 kV, PF = 0,90.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "P är den aktiva effekten i W, U_{L} linjespänningen i V och I_{L} linjeströmmen i A.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Gör om MW till W och kV till V och sätt in värdena.",
      "status": "migrerad"
    },
    {
      "niva": "nasta-steg",
      "text": "1) Gör om till grundenheter: MW till W och kV till V. 2) Sätt in i I_{L} = P/(√3 · U_{L} · PF). Exempel: 2,0 MW vid 11 kV och PF = 0,85 ger I_{L} = 2 000 000/(1,732 · 11 000 · 0,85) ≈ 124 A.",
      "status": "utkast"
    }
  ],
  "losning": {
    "text": "I_{L} = 1 000 000/(1,732 · 6 600 · 0,90) ≈ 97 A.",
    "svar": [
      {
        "storhet": "I_{L}",
        "varde": 97.2,
        "avrundning": "1 decimaler",
        "tolerans": {
          "rel": 0.02
        },
        "enhet": "A"
      }
    ],
