  "uppgift": {
    "fraga": "En DC-pump tar 3,0 A vid 24 V. Beräkna tillförd elektrisk effekt.",
    "samband": [
      "P = U · I"
    ],
    "givet": "Likström med konstant 24 V och 3,0 A. Tillförd effekt är den elektriska effekt pumpen tar emot.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "P är elektrisk effekt i W, U spänning i V och I ström i A.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Multiplicera spänningen med strömmen. Kontrollera att enheten blir V · A = W.",
      "status": "migrerad"
    }
  ],
