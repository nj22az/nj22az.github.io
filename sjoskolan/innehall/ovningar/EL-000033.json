  "uppgift": {
    "fraga": "En 40 W-lampa går i 5 h och två 60 W-lampor går i 3 h. Beräkna total energi.",
    "samband": [
      "Etotal = E_{1} + E_{2}; Egrupp = antal · P · t"
    ],
    "givet": "Varje lampa drar sin märkeffekt under hela sin drifttid. Det finns två 60 W-lampor.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "Effekten per lampa anges i W. W · h ger Wh. 1 kWh = 1 000 Wh.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna energin för varje grupp, lägg ihop i Wh och dela med 1 000 för att få kWh.",
      "status": "migrerad"
    }
  ],
