  "uppgift": {
    "fraga": "En kontrollerad 12 V-rigg har 1 kΩ och 2 kΩ i serie. Beräkna strömmen och rita hur en voltmeter ska anslutas för att mäta U_{2}.",
    "samband": [
      "R_{total} = R_{1} + R_{2}; I = U/R_{total}",
      "U_{2} = I · R_{2}"
    ],
    "givet": "Kontrollerad 12 V DC-rigg med R_{1} = 1 kΩ och R_{2} = 2 kΩ i serie. Räkna med exakta värden.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "1 mA = 0,001 A. En voltmeter mäter mellan två punkter.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna ut totalresistansen, strömmen och U_{2}, och rita voltmetern parallellt över R_{2}.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "I = 12 V / 3 kΩ = 4,0 mA. U_{2} = 4,0 mA · 2 kΩ = 8,0 V. Voltmetern kopplas parallellt över R_{2}.",
    "svar": [
      {
        "storhet": "I",
        "varde": 4.0,
        "avrundning": "1 decimaler",
        "tolerans": {
          "rel": 0.02
        },
        "enhet": "mA"
      },
      {
        "storhet": "U_{2}",
        "varde": 8.0,
        "avrundning": "1 decimaler",
        "tolerans": {
          "rel": 0.02
        },
        "enhet": "V"
      }
    ],
