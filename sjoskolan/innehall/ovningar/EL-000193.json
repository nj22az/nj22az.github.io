  "uppgift": {
    "fraga": "Beräkna linjeströmmen för samma 1,0 MW och PF = 0,90 vid 400 V. Jämför med 6,6 kV.",
    "samband": [
      "I_{L} = P/(√3 U_{L} · PF)",
      "I_{låg}/I_{hög} = U_{hög}/U_{låg}"
    ],
    "givet": "P = 1,0 MW och PF = 0,90. Jämför 400 V med 6 600 V.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "Vid samma P och PF blir strömmen lika många gånger större som spänningen blir lägre.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna ut strömmen vid 400 V och kontrollera med kvoten mellan spänningarna.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "I_{L} ≈ 1 600 A. Det är 6 600/400 = 16,5 gånger strömmen vid 6,6 kV.",
