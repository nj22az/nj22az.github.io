  "uppgift": {
    "fraga": "En ideal transformator matar en resistiv last med 24 V och 3 A. Primärspänningen är 240 V. Bestäm effekten och primärströmmen.",
    "samband": [
      "U_{1} · I_{1} = U_{2} · I_{2}; I_{1} = U_{2} · I_{2}/U_{1}"
    ],
    "givet": "Ideal enfastransformator med resistiv last, PF = 1. U_{2} = 24 V, I_{2} = 3 A och U_{1} = 240 V. Förluster försummas.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "Spänning gånger ström ger skenbar effekt i VA, och för en resistiv last är det också den aktiva effekten i W.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna ut effekten på sekundärsidan och dela med primärspänningen. Håll isär primär- och sekundärsidan.",
      "status": "migrerad"
    }
  ],
