  "uppgift": {
    "fraga": "En motor ger Paxel = 5,5 kW med η = 0,88 och PF = 0,80 vid U_{L} = 400 V. Bestäm den tillförda elektriska effekten och linjeströmmen.",
    "samband": [
      "P_{in} = Paxel/η",
      "I_{L} = P_{in}/(√3 · U_{L} · PF)"
    ],
    "givet": "Paxel = 5,5 kW, η = 0,88, PF = 0,80 och U_{L} = 400 V. Symmetrisk trefas.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "Paxel är effekten på axeln och P_{in} den tillförda elektriska effekten. η och PF saknar enhet.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna först P_{in} och gör om kW till W innan du räknar linjeströmmen.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "P_{in} = 5,5/0,88 = 6,25 kW. I_{L} = 6 250/(1,732 · 400 · 0,80) ≈ 11,3 A.",
    "svar": [
      {
        "storhet": "P_{in}",
        "varde": 6.25,
