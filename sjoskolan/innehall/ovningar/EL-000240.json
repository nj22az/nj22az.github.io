  "uppgift": {
    "fraga": "En 24 V-källa matar en last. Vid 4 A mäts 20 V vid lasten. Efter en åtgärd mäts 23,6 V vid samma ström. Beräkna slingresistansen före och efter.",
    "samband": [
      "R_{slinga} = (U_{källa} − U_{last})/I"
    ],
    "givet": "Källan håller 24 V. Vid 4 A är spänningen vid lasten 20 V före och 23,6 V efter. Mätpunkterna är desamma.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "Slingresistansen är resistansen i fram- och returledaren tillsammans.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna ut spänningsfallet och resistansen före och efter, och jämför.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "Före: (24 − 20)/4 = 1,0 Ω. Efter: (24 − 23,6)/4 = 0,10 Ω.",
