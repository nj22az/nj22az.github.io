  "uppgift": {
    "fraga": "Använd värdena i uppgift 4. Beräkna resistansen i framledaren och i returledaren.",
    "samband": [
      "R_{fram} = ΔU_{fram}/I; R_{retur} = ΔU_{retur}/I"
    ],
    "givet": "Källa 24 V, last 20 V, I = 2 A. ΔU_{retur} = 1 V och ΔU_{fram} = 24 − 20 − 1 V.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "I en enkel seriekrets går samma ström i fram- och returledaren.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna ut fallet i framledaren och dela varje spänningsfall med strömmen.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "Rfram = 3/2 = 1,5 Ω. Rretur = 1/2 = 0,5 Ω.",
