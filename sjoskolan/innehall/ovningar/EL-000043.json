  "uppgift": {
    "fraga": "En 24 V-källa matar tre resistorer i serie. Två av spänningsfallen är 6 V och 10 V. Bestäm det tredje, U_{x}.",
    "samband": [
      "ΣΔU = 0; U_{x} = E − U_{1} − U_{2}"
    ],
    "givet": "En källa, tre resistorer i serie och inget spänningsfall i ledningarna. E = 24 V, U_{1} = 6 V, U_{2} = 10 V.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "E är källans spänning i V. U_{1}, U_{2} och U_{x} är spänningsfallen över resistorerna.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Gå från källans minus till plus och sedan genom resistorerna. Källans spänning ska räcka till alla spänningsfallen.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "U_{x} = 24 − 6 − 10 = 8 V.",
    "svar": [
      {
        "storhet": "U_{x}",
        "varde": 8.0,
