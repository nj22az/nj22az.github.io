  "uppgift": {
    "fraga": "Två fasströmmar på 10 A ligger 120° isär. Den tredje fasen är obelastad. Bestäm strömmen i neutralledaren.",
    "samband": [
      "I_{N} = √(I_{1}² + I_{2}² + 2 · I_{1} · I_{2} cos120°)"
    ],
    "givet": "I_{1} = I_{2} = 10 A, 120° isär, och I_{3} = 0. Neutralledaren är hel.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "Formeln ger storleken på summan av två visare. cos120° = −0,5 – glöm inte minustecknet.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna ut uttrycket under roten och dra sedan roten ur.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "I_{N} = √(100 + 100 − 100) = 10 A.",
    "svar": [
      {
        "storhet": "I_{N}",
        "varde": 10.0,
        "avrundning": "heltal",
        "tolerans": {
          "rel": 0.02
        },
        "enhet": "A"
      }
    ],
