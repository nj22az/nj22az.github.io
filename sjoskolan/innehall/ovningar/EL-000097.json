  "uppgift": {
    "fraga": "En last mellan en fas och neutral tar 5,0 A. De två andra faserna är obelastade. Bestäm strömmen i neutralledaren.",
    "samband": [
      "Nodlagen: Σ in = Σ ut"
    ],
    "givet": "En fas tar 5,0 A, de andra två ingenting. Neutralledaren är hel.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "I_{N} är neutralledarens ström. Den för tillbaka strömmen från fas–neutral-lasterna.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Använd nodlagen. All utgående lastström måste återkomma genom neutralledaren.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "I_{N} = 5,0 A. All ström från den enda lasten återvänder i neutralledaren.",
