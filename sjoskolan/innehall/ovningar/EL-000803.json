  "uppgift": {
    "fraga": "En sladdansluten länspump i en fuktig skans har en synligt skadad kabel vid införingen i pumpen. Pumpen behövs för att hålla skansen länsad.",
    "delfragor": [
      {
        "id": "a",
        "text": "Fyll i mallen: observation, fara, möjlig händelse och konsekvens."
      },
      {
        "id": "b",
        "text": "Skriv vilket beslut som tas nu och vem som tar det."
      },
      {
        "id": "c",
        "text": "Föreslå en direkt åtgärd och en förebyggande åtgärd, och hur länsningen säkras under tiden."
      },
      {
        "id": "d",
        "text": "Skilj på vad du har observerat och vad du antar."
      }
    ],
    "svarsformat": "Ifylld riskbedömningsmall med egna formuleringar."
  },
