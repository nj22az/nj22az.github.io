  "uppgift": {
    "fraga": "Frekvensen ökas från 50 till 100 Hz. Hur ändras XL och XC när komponenterna är desamma?",
    "samband": [
      "XL = 2πfL; XC = 1/(2πfC)"
    ],
    "givet": "Bara frekvensen ändras, från 50 till 100 Hz. L och C är desamma."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "XL ökar med f. XC minskar när f ökar, eftersom f står i nämnaren.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Byt f mot 2f i båda formlerna och jämför med de ursprungliga värdena.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "X_{L} fördubblas. X_{C} halveras.",
