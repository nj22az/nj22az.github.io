  "uppgift": {
    "fraga": "En period tar fyra rutor, och tidsbasen är 5 ms per ruta. Beräkna periodtid och frekvens.",
    "samband": [
      "T = antal rutor · tid/ruta; f = 1/T"
    ],
    "givet": "En hel period tar 4 rutor. Tidsbasen är 5 ms per ruta.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "T måste vara i sekunder för att f ska bli i Hz. 1 ms = 0,001 s.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna ut periodtiden i ms, gör om till s och dela sedan 1 med den.",
      "status": "migrerad"
    }
  ],
