  "uppgift": {
    "fraga": "Två isolationsvägar på 20 MΩ vardera går parallellt från samma ledare till jord. Beräkna den sammanlagda resistansen.",
    "samband": [
      "R_{p} = R_{1} · R_{2}/(R_{1} + R_{2})"
    ],
    "givet": "R_{1} = R_{2} = 20 MΩ. Båda vägarna går mellan samma ledare och jord.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "Två parallella vägar släpper tillsammans igenom mer läckström än en ensam.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Använd parallellformeln och räkna i MΩ hela vägen.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "Rp = 20 · 20/40 = 10 MΩ.",
