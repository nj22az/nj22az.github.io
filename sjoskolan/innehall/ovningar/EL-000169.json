{
  "id": "EL-000169",
  "titel": "Motorförluster",
  "sprak": "sv",
  "typ": "berakning",
  "revision": 4,
  "granskning": {
    "status": "migrerad",
    "numeriskt_kontrollerad": true
  },
  "larande": {
    "mal": [
      "LM-1"
    ],
    "niva": "analys",
    "teori": [
      "T-bok-17",
