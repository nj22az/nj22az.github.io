  "uppgift": {
    "fraga": "Källan har 24 V, lasten 20 V och strömmen är 2 A. Spänningsfallet i returledaren är uppmätt till 1 V. Hur stort är fallet i framledaren?",
    "samband": [
      "ΔU_{total} = U_{källa} − U_{last}",
      "ΔU_{fram} = ΔU_{total} − ΔU_{retur}"
    ],
    "givet": "Källa 24 V, last 20 V, ström 2 A och 1 V i returledaren. Värdena är mätta samtidigt.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "Hela spänningsfallet är summan av fallet i framledaren och i returledaren.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna först ut hela fallet och dra sedan bort returledarens del.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "Slingfall 4 V. Framledningen 3 V.",
