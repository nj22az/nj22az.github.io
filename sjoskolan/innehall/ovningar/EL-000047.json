  "uppgift": {
    "fraga": "6 A kommer till två parallellgrenar på 3 Ω och 6 Ω. Bestäm strömmen i varje gren.",
    "samband": [
      "I_{1} = I_{total} · R_{2}/(R_{1} + R_{2})",
      "I_{2} = I_{total} − I_{1}"
    ],
    "givet": "Två parallella grenar med resistorer. I_{total} = 6 A, R_{1} = 3 Ω och R_{2} = 6 Ω.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "I_{1} går genom R_{1}, men det är den andra resistorn, R_{2}, som står i täljaren. Lägre resistans ger större ström.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna först ut den ena grenströmmen och sedan den andra. Kontrollera att I_{1}R_{1} = I_{2}R_{2}.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "I_{1} (3 Ω) = 6 · 6/9 = 4,0 A, I_{2} (6 Ω) = 2,0 A. Kontroll: 4 · 3 = 2 · 6 = 12 V.",
