  "uppgift": {
    "fraga": "En värmare på 1,5 kW går i 40 minuter. Beräkna energin i kWh.",
    "samband": [
      "E = P · t; t[h] = t[min]/60"
    ],
    "givet": "Effekten är 1,5 kW under hela tiden.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "E är energi i kWh när P anges i kW och t i timmar.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Gör först om tiden till timmar och multiplicera sedan med effekten.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "t = 40/60 h ≈ 0,667 h. E = 1,5 kW · 0,667 h = 1,0 kWh.",
