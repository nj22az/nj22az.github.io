  "uppgift": {
    "fraga": "Två ideala källor på 12 V och 9 V matar punkten A genom var sin 3 Ω-resistor. Mellan A och den gemensamma 0 V-punkten sitter 2 Ω. Bestäm V_{a}.",
    "samband": [
      "(E_{1} − V_{a})/R_{1} + (E_{2} − V_{a})/R_{2} = V_{a}/R_{3}"
    ],
    "givet": "E_{1} = 12 V, E_{2} = 9 V, R_{1} = R_{2} = 3 Ω, R_{3} = 2 Ω. Båda minuspolerna är anslutna till 0 V.",
    "instruktion": "+"
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "V_{a} är spänningen i A mot 0 V. Varje bråk är en grenström enligt Ohms lag.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Multiplicera hela ekvationen med 6 så försvinner nämnarna. Samla termerna med V_{a} och lös ut V_{a}.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "2(12 − V_{a}) + 2(9 − V_{a}) = 3V_{a} ger 42 = 7V_{a} och V_{a} = 6,0 V.",
    "svar": [
      {
        "storhet": "V_{a}",
        "varde": 6.0,
        "avrundning": "heltal",
        "tolerans": {
          "rel": 0.02
        },
        "enhet": "V"
      }
    ],
