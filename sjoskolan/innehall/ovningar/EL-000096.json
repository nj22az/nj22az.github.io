  "uppgift": {
    "fraga": "Tre rena sinusströmmar på 8,0 A ligger 120° isär. Bestäm strömmen i neutralledaren (effektivvärde).",
    "samband": [
      "Visarsumma: I_{N} = −(I_{1} + I_{2} + I_{3})"
    ],
    "givet": "Tre rena sinusströmmar på 8,0 A, exakt 120° isär.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "Symbolen med pil betecknar en visare med belopp och fasvinkel. Neutralströmmen sluter strömbalansen.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Rita de tre visarna efter varandra, spets mot fot. Vad blir summan?",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "IN = 0 A. Tre lika visare med 120° emellan har summan noll.",
