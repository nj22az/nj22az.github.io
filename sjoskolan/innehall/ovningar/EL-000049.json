  "uppgift": {
    "fraga": "12 V matar R_{1} = 1 kΩ i serie med R_{2} = 2 kΩ. Lasten ska anslutas över R_{2}. Bestäm U_{th} och R_{th} när ingen last är ansluten.",
    "samband": [
      "U_{th} = U_{in} · R_{2}/(R_{1} + R_{2})",
      "R_{th} = R_{1} · R_{2}/(R_{1} + R_{2})"
    ],
    "givet": "Likströmskrets med en ideal 12 V-källa. R_{1} = 1 kΩ, R_{2} = 2 kΩ. Ingen last är ansluten.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "U_{th} är spänningen mellan lastens anslutningspunkter när ingen last är ansluten. R_{th} är resistansen mellan samma punkter med källan nollställd.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna först tomgångsspänningen. Ersätt sedan källan med en ledning – bara i beräkningen.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "Uth = 12 · 2/3 = 8,0 V. Rth = 1 · 2/3 = 2/3 kΩ ≈ 0,667 kΩ.",
    "svar": [
      {
        "storhet": "U_{th}",
        "varde": 8.0,
