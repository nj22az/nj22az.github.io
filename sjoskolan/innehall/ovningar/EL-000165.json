  "uppgift": {
    "fraga": "En fyrpolig 50 Hz-motor går med 1 440 r/min. Beräkna eftersläpningen i procent.",
    "samband": [
      "n_{s} = 120f/p",
      "s% = 100 · (n_{s} − n)/n_{s}"
    ],
    "givet": "f = 50 Hz, p = 4 och n = 1 440 r/min. Motorn går som motor, alltså inte som generator.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "n är rotorns verkliga varvtal.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna först ut n_{s}, sedan skillnaden n_{s} − n som andel av n_{s}, och gör om till procent.",
      "status": "migrerad"
    }
  ],
