  "uppgift": {
    "fraga": "En avsedd trefasrigg ger 12,0 V mellan faserna. Vilken spänning förväntas över varje gren i en symmetrisk Y-last?",
    "samband": [
      "U_{gren},Y = U_{L}/√3"
    ],
    "givet": "Avsedd övningsrigg med U_{L} = 12,0 V, lika fasimpedanser och symmetrisk källa.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "U_{gren},Y är spänningen över en lastgren i Y-koppling.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna ut grenspänningen från linjespänningen.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "Ugren = 12,0/1,732 ≈ 6,93 V.",
    "svar": [
      {
        "storhet": "U_{gren}",
        "varde": 6.93,
        "avrundning": "2 decimaler",
        "tolerans": {
          "rel": 0.02
        },
