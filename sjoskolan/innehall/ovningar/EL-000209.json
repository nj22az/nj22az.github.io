  "uppgift": {
    "fraga": "Tre mätningar ger 9,8, 10,0 och 10,2 V. Beräkna medelvärde och variationsbredd.",
    "samband": [
      "Medel = (x_{1} + x_{2} + x_{3})/3",
      "Variationsbredd = xmax − xmin"
    ],
    "givet": "Mätvärdena 9,8, 10,0 och 10,2 V. Ingen statistisk analys behövs.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "Medelvärdet visar var värdena ligger, och variationsbredden är största minus minsta värdet.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Lägg ihop värdena och dela med tre. Räkna sedan variationsbredden för sig.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "Medel = 10,0 V. Variationsbredd = 0,4 V.",
