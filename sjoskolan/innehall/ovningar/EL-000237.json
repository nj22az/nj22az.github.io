  "uppgift": {
    "fraga": "Ett instrument visar 24,00 V. Specifikationen är ±(1,0 % + 2 siffror) och upplösningen 0,01 V. Beräkna felgränsen.",
    "samband": [
      "δ = (a/100) · visning + n · upplösning"
    ],
    "givet": "Visat värde 24,00 V, a = 1,0, n = 2 och upplösning 0,01 V.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "δ är felgränsen. n siffror betyder n steg i sista siffran, inte n decimaler.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna procentdelen och siffrornas del var för sig, lägg ihop och skriv svaret som visat värde ± δ.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "δ = 0,24 + 0,02 = 0,26 V. 24,00 ± 0,26 V, alltså 23,74–24,26 V.",
