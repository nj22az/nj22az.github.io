  "uppgift": {
    "fraga": "En ideal trefastransformator är märkt 100 kVA och 10 kV/400 V (linjespänningar). Bestäm linjeströmmen på sekundärsidan vid full last.",
    "samband": [
      "I_{2} = S/(√3 · U_{2})"
    ],
    "givet": "Ideal symmetrisk trefastransformator, 100 kVA och 10 kV/400 V.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "S är transformatorns märkeffekt i VA. U_{2} och I_{2} är linjespänning och linjeström på sekundärsidan.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Använd 100 000 VA och sekundärsidans 400 V – primärspänningen ska inte vara med här.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "I_{2} = 100 000/(1,732 · 400) ≈ 144 A.",
