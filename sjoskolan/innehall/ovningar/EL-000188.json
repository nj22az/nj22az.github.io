  "uppgift": {
    "fraga": "Zs ökar från 0,46 till 0,92 Ω vid oförändrade 230 V. Hur ändras felströmmen?",
    "samband": [
      "I_{1} = U_{0}/Zs_{1}; I_{2} = U_{0}/Zs_{2}"
    ],
    "givet": "U_{0} = 230 V. Impedansen ökar från 0,46 till 0,92 Ω.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "1 och 2 står för de två fallen. Vid samma U_{0} blir strömmen hälften så stor när Zs blir dubbelt så stor.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna ut båda strömmarna och ange hur mycket strömmen ändras.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "I_{k} halveras till 250 A.",
