  "uppgift": {
    "fraga": "En enfaskrets har 5,000 A ut och 4,970 A tillbaka genom de övervakade ledarna. Beräkna differensströmmen.",
    "samband": [
      "IΔ = |I_{ut} − I_{retur}|"
    ],
    "givet": "Strömmarna är uppmätta samtidigt: 5,000 A ut och 4,970 A tillbaka.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "IΔ är differensströmmen.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Dra returströmmen från den utgående strömmen och multiplicera med 1 000 för att få mA.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "IΔ = 5,000 − 4,970 = 0,030 A = 30 mA.",
    "svar": [
      {
        "storhet": "IΔ",
        "varde": 30.0,
        "avrundning": "heltal",
