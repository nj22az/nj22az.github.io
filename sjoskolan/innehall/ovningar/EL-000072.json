    {
      "niva": "begrepp",
      "text": "XC är den kapacitiva reaktansen i Ω och C kapacitansen i F. 1 µF = 10^{−6} F.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Gör om µF till F. Räkna ut hela nämnaren innan du delar 1 med den.",
