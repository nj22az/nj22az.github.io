      "facit": 1.0
    },
    "initial": {
      "del": "prov",
      "obj": "kabel-skadad",
      "par": "L2-PE",
      "Uprov": 500
    },
    "fraga": {
      "storhet": "prov",
      "etikett": "I_{läck}",
