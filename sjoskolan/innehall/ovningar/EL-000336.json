    "losning_publik": true
  },
  "ledtradar": [
    {
      "niva": "metod",
      "text": "I = U_{prov}/R. 0,5 MΩ = 500 000 Ω.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "I = 500/500 000 = 0,001 A = 1,0 mA. Det är mycket mer än en frisk kabel läcker, och L2 ligger under gränsen 1 MΩ. En verklig provare ger bara några mA. Vid mycket lägre resistans orkar den inte hålla 500 V.",
    "svar": [
      {
        "storhet": "I_{läck}",
        "varde": 1.0,
        "tolerans": {
          "rel": 0.02
        },
        "enhet": "mA",
        "berakning": "isolation.provstrom_ma"
      }
    ],
    "status": "migrerad",
