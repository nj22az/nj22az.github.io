  "uppgift": {
    "fraga": "Vilket synkront varvtal ger sex poler och 50 Hz?",
    "samband": [
      "n_{s} = 120f/p"
    ],
    "givet": "Landnät. p = 6 poler och f = 50 Hz.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "Fler poler ger lägre varvtal vid samma frekvens.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Sätt in p = 6. Svaret blir i r/min, eftersom formeln redan räknar om till minuter.",
      "status": "migrerad"
    },
    {
      "niva": "nasta-steg",
      "text": "1) Använd n_{s} = 120 · f/p med p = antal poler. 2) Räkna i ordning: 120 · f först, dela sedan med p. Exempel ombord: 60 Hz och åtta poler ger n_{s} = 120 · 60/8 = 900 r/min.",
      "status": "utkast"
    }
  ],
  "losning": {
    "text": "n_{s} = 120 · 50/6 = 1 000 r/min.",
    "svar": [
      {
        "storhet": "n_{s}",
        "varde": 1000.0,
        "avrundning": "heltal",
        "tolerans": {
          "rel": 0.02
        },
        "enhet": "r/min"
      }
    ],
