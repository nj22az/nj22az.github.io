  "uppgift": {
    "fraga": "12 V ligger över 6 Ω och 4 Ω parallellt. Bestäm grenströmmarna och totalströmmen.",
    "samband": [
      "I_{1} = U/R_{1}; I_{2} = U/R_{2}; I = I_{1} + I_{2}"
    ],
    "givet": "U = 12 V över båda grenarna. R_{1} = 6 Ω och R_{2} = 4 Ω.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "Parallella grenar har samma spänning U, men strömmarna kan vara olika.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna ut varje grenström med Ohms lag och lägg ihop dem med strömlagen.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "I_{1} = 12/6 = 2,0 A, I_{2} = 12/4 = 3,0 A, I = 5,0 A.",
