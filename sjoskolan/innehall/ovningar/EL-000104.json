  "uppgift": {
    "fraga": "En symmetrisk trefaslast har U_{L} = 400 V, I_{L} = 10 A och cos φ = 0,80. Beräkna P.",
    "samband": [
      "P = √3 · U_{L} · I_{L} · cos φ"
    ],
    "givet": "Symmetrisk sinusformad last, U_{L} = 400 V, I_{L} = 10 A, cos φ = 0,80.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "P är den totala aktiva effekten i alla tre faserna. U_{L} och I_{L} är linjevärden (effektivvärden).",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Multiplicera de fyra faktorerna. Svaret blir i W – dela med 1 000 för kW.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "P = 1,732 · 400 · 10 · 0,80 ≈ 5 540 W ≈ 5,54 kW.",
    "svar": [
