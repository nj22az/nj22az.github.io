  "uppgift": {
    "fraga": "En 24 V-last tar 6 A. Slingresistansen i matningen är 0,15 Ω. Beräkna spänningsfallet och lastspänningen.",
    "samband": [
      "ΔU = I · R_{slinga}; U_{last} = U_{källa} − ΔU"
    ],
    "givet": "Likspänning: U_{källa} = 24 V, I = 6 A, R_{slinga} = 0,15 Ω.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "R_{slinga} gäller både fram- och returledaren.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna ut spänningsfallet och dra det från källans spänning.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "ΔU = 6 · 0,15 = 0,9 V. Ulast = 23,1 V.",
