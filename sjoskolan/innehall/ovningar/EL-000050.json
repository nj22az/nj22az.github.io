  "uppgift": {
    "fraga": "Använd U_{th} = 8 V och R_{th} = 2/3 kΩ. Anslut R_{last} = 2 kΩ. Beräkna strömmen genom lasten och spänningen över den.",
    "samband": [
      "I_{last} = U_{th}/(R_{th} + R_{last})",
      "U_{last} = I_{last} · R_{last}"
    ],
    "givet": "U_{th} = 8 V, R_{th} = 2/3 kΩ och R_{last} = 2 kΩ. Räkna med 2/3 och avrunda inte förrän på slutet.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "V/kΩ ger mA och mA · kΩ ger V. Använd samma enhet för alla resistanser i nämnaren.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna ut lastströmmen och sedan spänningen över lasten.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "Ilast = 8 V / (2/3 + 2) kΩ = 3,0 mA. Ulast = 3,0 mA · 2 kΩ = 6,0 V, samma som i övning 6.",
