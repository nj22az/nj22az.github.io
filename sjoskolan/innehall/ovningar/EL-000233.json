  "uppgift": {
    "fraga": "24 V matar R_{1} = 2 kΩ och R_{2} = 4 kΩ i serie. En last på 4 kΩ ligger parallellt med R_{2}. Beräkna utspänningen.",
    "samband": [
      "R_{p} = R_{2} · R_{last}/(R_{2} + R_{last})",
      "U_{ut} = U_{in} · R_{p}/(R_{1} + R_{p})"
    ],
    "givet": "U_{in} = 24 V, R_{1} = 2 kΩ, R_{2} = R_{last} = 4 kΩ. Ideal källa och resistorer med konstant resistans.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "R_{p} ersätter den nedre resistorn och lasten, som ligger parallellt.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna alla resistanser i samma enhet. Förenkla parallellkopplingen först och använd sedan R_{p} i delningsformeln.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "Rp = 4 · 4/8 = 2 kΩ. Uut = 24 · 2/(2 + 2) = 12 V.",
    "svar": [
      {
        "storhet": "U_{ut}",
        "varde": 12.0,
        "avrundning": "heltal",
        "tolerans": {
          "rel": 0.02
        },
        "enhet": "V"
      }
    ],
