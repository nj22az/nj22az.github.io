  "uppgift": {
    "fraga": "Tre resistorer på 40 Ω kopplas i Δ till 400 V. Bestäm grenströmmen och linjeströmmen.",
    "samband": [
      "Δ: U_{gren} = U_{L}; I_{gren} = U_{gren}/R",
      "I_{L} = √3 · I_{gren}"
    ],
    "givet": "Symmetrisk Δ-last, tre resistorer på 40 Ω och U_{L} = 400 V RMS.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "I Δ är linjeströmmen skillnaden mellan två grenströmmar, räknad som visare.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna ut grenströmmen och multiplicera sedan med √3 för att få linjeströmmen.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "I_{gren} = 400/40 = 10 A. I_{L} = 1,732 · 10 ≈ 17,3 A, tre gånger linjeströmmen i Y.",
    "svar": [
      {
        "storhet": "I_{gren}",
