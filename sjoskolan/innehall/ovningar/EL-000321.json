    "losning_publik": true
  },
  "ledtradar": [
    {
      "niva": "metod",
      "text": "S0 är sluten, så a har samma potential som +U. Returen håller 0 V-sidan på 0 V.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "a är förbunden med +24 V genom den slutna S0. U = 24 − 0 = 24 V, trots att ingen ström går.",
    "svar": [
      {
        "storhet": "U(a–0 V)",
        "varde": 24,
        "tolerans": {
          "rel": 0.02
        },
        "enhet": "V"
      }
    ],
