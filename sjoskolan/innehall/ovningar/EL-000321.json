  "uppgift": {
    "fraga": "Kretsen är i vila: S0 sluten, S1 öppen, K1 släppt. Matningen är 24 V. Vilken spänning visar mätaren mellan a (efter S0) och 0 V?"
  },
  "referenser": {
    "ursprung": [
      {
        "kalla": "hallkretslabbet/lessons.mjs CHALLENGES[0] (id vila)",
        "revision": "8cabde3",
