  "uppgift": {
    "fraga": "En ideal enfastransformator har N_{1} = 1 000 varv och N_{2} = 100 varv. U_{1} = 230 V. Bestäm U_{2}.",
    "samband": [
      "U_{2} = U_{1} · N_{2}/N_{1}"
    ],
    "givet": "Ideal enfastransformator. N_{1} = 1 000, N_{2} = 100 och U_{1} = 230 V RMS.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "N_{1} och N_{2} är antalet varv i lindningarna; 1 är primärsidan och 2 sekundärsidan.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna ut förhållandet N_{2}/N_{1} och multiplicera primärspänningen med det.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "U_{2} = 230 · 100/1 000 = 23 V.",
