  "uppgift": {
    "fraga": "En motor ger 600 W mekanisk effekt. Verkningsgraden är 75 %. Beräkna den tillförda elektriska effekten och förlusten.",
    "samband": [
      "P_{in} = P_{ut}/η; Pförlust = P_{in} − P_{ut}"
    ],
    "givet": "η = 75 % = 0,75. Motorn går med jämn belastning.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "η skrivs som decimaltal. P_{ut} är effekten på axeln och P_{in} den tillförda elektriska effekten.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Dela uteffekten med verkningsgraden och dra sedan bort uteffekten från den tillförda effekten.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "P_{in} = 600 W / 0,75 = 800 W. Förlust = 800 − 600 = 200 W.",
    "svar": [
      {
        "storhet": "P_{in}",
        "varde": 800.0,
        "avrundning": "heltal",
        "tolerans": {
          "rel": 0.02
        },
        "enhet": "W"
      },
