  "uppgift": {
    "fraga": "En 24 V-pump ger 120 W mekaniskt med η = 80 %. Den går i 2 h. Beräkna den tillförda energin och hur många Ah som går åt.",
    "samband": [
      "P_{in} = P_{ut}/η; E = P_{in} · t",
      "I = P_{in}/U; Q = I · t"
    ],
    "givet": "Konstant 24 V och 120 W uteffekt under 2 h. η = 0,80. Ingen marginal i batteriet är medräknad.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "Med W och h får du E i Wh, och med A och h får du Q i Ah. Skriv η som decimaltal.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna i tur och ordning tillförd effekt, energi och ström, och sist Ah – en annan storhet än Wh.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "P_{in} = 120/0,80 = 150 W. E = 150 W · 2 h = 300 Wh. I = 150/24 = 6,25 A. Q = 6,25 A · 2 h = 12,5 Ah.",
    "svar": [
      {
        "storhet": "E",
        "varde": 300.0,
        "avrundning": "heltal",
        "tolerans": {
          "rel": 0.02
        },
        "enhet": "Wh"
      },
      {
        "storhet": "Q",
        "varde": 12.5,
        "avrundning": "1 decimaler",
        "tolerans": {
          "rel": 0.02
        },
        "enhet": "Ah"
      }
    ],
