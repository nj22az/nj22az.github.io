  "uppgift": {
    "fraga": "Du mäter 95–96 på överlastreläet i den spänningslösa startaren. Vad ska multimetern visa när reläet inte har löst ut?",
    "alternativ": [
      "Nära 0 Ω, kontakten är sluten",
      "Överområde, kontakten är öppen",
      "Spolens resistans"
    ]
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "95–96 är överlastreläets kontakt i styrkretsen. Är den normalt öppen eller normalt sluten?",
      "status": "utkast"
    }
  ],
  "losning": {
    "text": "95–96 är normalt sluten (NC). Den öppnar först när reläet löser ut och bryter då spolens matning.",
    "status": "utkast",
    "kommentar": "Nära 0 Ω, kontakten är sluten"
