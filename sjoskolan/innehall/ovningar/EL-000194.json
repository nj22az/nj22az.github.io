  "uppgift": {
    "fraga": "En ideal strömtransformator har omsättningen 200/5 A. Primärströmmen är 120 A. Beräkna sekundärströmmen.",
    "samband": [
      "kI = I_{1},märk/I_{2},märk; I_{2} = I_{1}/kI"
    ],
    "givet": "Ideal strömtransformator 200/5 A. Primärströmmen I_{1} = 120 A. Uppgiften gäller bara beräkningen.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "kI är omsättningen och saknar enhet; 1 är primärsidan och 2 sekundärsidan.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna först ut omsättningen och dela sedan primärströmmen med den.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "kI = 200/5 = 40. I_{2} = 120/40 = 3,0 A.",
