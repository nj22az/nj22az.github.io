  "uppgift": {
    "fraga": "Källan ger 24 V. Kabelslingan har R = 0,140 Ω och lasten tar 5,0 A. Beräkna spänningen vid lasten och spänningsfallet i procent.",
    "samband": [
      "ΔU = I · R; U_{last} = U_{källa} − ΔU",
      "Fall i % = 100 · ΔU/U_{källa}"
    ],
    "givet": "R = 0,140 Ω gäller hela slingan. Strömmen är 5,0 A.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "ΔU är kabelslingans spänningsfall.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna kabelns spänningsfall, dra det från källans 24 V och räkna ut hur stor andel av 24 V fallet är.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "ΔU = 5,0 A · 0,140 Ω = 0,70 V. Ulast = 24 − 0,70 = 23,3 V. Fall = 100 · 0,70/24 ≈ 2,9 %.",
    "svar": [
      {
        "storhet": "U_{last}",
