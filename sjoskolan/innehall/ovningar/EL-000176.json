  "uppgift": {
    "fraga": "I 12 V-hållkretsen är STOPP sluten, START öppen och K1 opåverkad. Returen är hel. Vilken spänning ligger över K1-spolen (idealt)?",
    "samband": [
      "Öppen matningsväg ger Ispole = 0",
      "Uspole = Rspole · Ispole"
    ],
    "givet": "12 V, STOPP sluten, START öppen, K1 i vila och hel retur. Det finns ingen annan matning.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "Vilka punkter är förbundna med matningen och vilka med returen?",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Följ vägen till spolen. Använd sedan Ohms lag för att avgöra spänningen över den.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "0 V. Ingen ström går, så det blir inget spänningsfall över spolen.",
