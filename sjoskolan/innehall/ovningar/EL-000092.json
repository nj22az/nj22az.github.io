  "uppgift": {
    "fraga": "Ett symmetriskt trefassystem har f = 50 Hz. Hur många ms motsvarar 120°?",
    "samband": [
      "T = 1/f; Δt = T · φ/360°"
    ],
    "givet": "f = 50 Hz och φ = 120°.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "T är periodtiden, Δt tidsförskjutningen och φ vinkeln i grader. 1 s = 1 000 ms.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna först ut periodtiden och sedan hur stor del av den som 120° motsvarar.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "T = 20 ms. Δt = 20 · 120/360 ≈ 6,67 ms.",
    "svar": [
      {
        "storhet": "Δt",
        "varde": 6.67,
        "avrundning": "2 decimaler",
        "tolerans": {
          "rel": 0.02
        },
        "enhet": "ms"
      }
    ],
    "status": "migrerad",
