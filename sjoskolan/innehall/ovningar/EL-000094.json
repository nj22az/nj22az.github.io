  "uppgift": {
    "fraga": "U_{F} = 120 V. Beräkna linjespänningen i ett symmetriskt system.",
    "samband": [
      "U_{L} = √3 · U_{F}"
    ],
    "givet": "Symmetrisk källa. U_{F} = 120 V mellan fas och neutral.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "Fasvisarna är lika långa och ligger 120° isär. Skillnaden mellan dem är linjespänningen.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Multiplicera med √3 – linjespänningen är inte 2U_{fas}.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "U_{L} = 1,732 · 120 ≈ 208 V, inte 240 V.",
