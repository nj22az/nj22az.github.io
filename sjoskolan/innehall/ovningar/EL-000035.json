  "uppgift": {
    "fraga": "En resistor på 12 Ω ansluts till 24 V DC. Beräkna ström och effekt.",
    "samband": [
      "I = U/R; P = U · I = U²/R"
    ],
    "givet": "Resistor med konstant R = 12 Ω. Källan håller 24 V över resistorn.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "R är resistans i Ω.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna strömmen med Ohms lag och använd den sedan för att räkna effekten.",
      "status": "migrerad"
    }
  ],
