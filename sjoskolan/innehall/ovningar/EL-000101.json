    {
      "niva": "begrepp",
      "text": "U_{L} är linjespänningen och U_{gren} spänningen över en av resistorerna i Y-lasten.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna ut grenspänningen från linjespänningen. Resistansen behövs först i nästa uppgift.",
