  "uppgift": {
    "fraga": "En sinusspänning har effektivvärdet 24 V och frekvensen 60 Hz. Beräkna toppvärde och periodtid.",
    "samband": [
      "û = √2 · U_{RMS}; T = 1/f"
    ],
    "givet": "Ren sinus utan likspänningsdel, U_{RMS} = 24 V och f = 60 Hz.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "û är toppvärde. T är period i s. Multiplicera T med 1 000 för ms.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Beräkna toppvärde och period separat. Använd RMS endast i omvandlingen, inte som toppvärde.",
