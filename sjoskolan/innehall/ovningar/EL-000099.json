  "uppgift": {
    "fraga": "U_{12} = 400 V, U_{23} = 402 V och U_{31} = 398 V. Beräkna medelvärdet och den största avvikelsen i procent av medelvärdet.",
    "samband": [
      "U_{medel} = (U_{12} + U_{23} + U_{31})/3",
      "Avvikelse i % = 100 · max|U_{i} − U_{medel}|/U_{medel}"
    ],
    "givet": "Mätvärdena 400, 402 och 398 V. Uppgiften använder ett enkelt mått på spridning.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "max betyder den största avvikelsen, oavsett tecken. Ui är ett av de tre mätvärdena.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Räkna ut medelvärdet, jämför varje mätvärde med det och använd den största skillnaden.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "Medel = 400 V. Största avvikelse 2 V = 0,5 %.",
