  "uppgift": {
    "fraga": "En motor ger 400 W på axeln med η = 80 % och går i 3 h. Beräkna den tillförda elektriska effekten och energin.",
    "samband": [
      "P_{in} = P_{ut}/η; E = P_{in} · t"
    ],
    "givet": "P_{ut} = 400 W, η = 80 % = 0,80 och drifttiden 3 h. Driften är jämn.",
    "instruktion": "Redovisa din beräkning eller motivera ditt beslut."
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "P_{ut} är effekten på axeln. Dela med η som decimaltal för att få den tillförda effekten.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Gör om W till kW och multiplicera med tiden – kW · h ger kWh.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "P_{in} = 400/0,80 = 500 W. E = 0,5 kW · 3 h = 1,5 kWh.",
    "svar": [
      {
        "storhet": "P_{in}",
        "varde": 500.0,
        "avrundning": "heltal",
        "tolerans": {
          "rel": 0.02
        },
        "enhet": "W"
      },
