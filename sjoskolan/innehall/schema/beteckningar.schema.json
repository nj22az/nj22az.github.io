{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nj22az.github.io/sjoskolan/innehall/schema/beteckningar.schema.json",
  "title": "Sjöskolan · förkortningar, storheter och enheter",
  "type": "object",
  "required": [
    "beteckningar"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "beskrivning": {
      "type": "string"
    },
    "beteckningar": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "visa",
          "former",
          "namn",
          "forklaring",
          "veckor"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "visa": {
            "type": "string",
            "description": "Så visas beteckningen i ordlistan (med markering X_{L})."
          },
          "former": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Hur beteckningen kan stå i löptext (index skrivna som vanliga tecken)."
          },
          "formel": {
            "type": "boolean",
            "description": "Letas bara i formler och samband (ensam bokstav)."
          },
          "namn": {
            "type": "string",
            "minLength": 2
          },
          "utlasning": {
            "type": "string",
            "description": "Vad bokstäverna står för."
          },
          "forklaring": {
            "type": "string",
            "minLength": 10
          },
          "enhet": {
            "type": "string"
          },
          "exempel": {
            "type": "string"
          },
          "obs": {
            "type": "string",
            "description": "Varning för förväxling, till exempel samma beteckning med annan betydelse en annan vecka."
          },
          "veckor": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer"
            }
          },
          "efter_tal": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Former som bara räknas direkt efter ett tal, eftersom de också är vanliga ord (var, rad) eller ensamma bokstäver (H, F)."
          }
        }
      }
    }
  }
}
