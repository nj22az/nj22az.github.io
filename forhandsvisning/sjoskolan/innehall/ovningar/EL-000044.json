  "uppgift": {
    "fraga": "En 12 V-källa matar R_{1} = 2 Ω och R_{2} = 4 Ω i serie. Bestäm strömmen och båda spänningsfallen.",
    "samband": [
      "E − R_{1} · I − R_{2} · I = 0",
      "I = E/(R_{1} + R_{2}); U_{1} = R_{1} · I, U_{2} = R_{2} · I"
    ],
    "givet": "Ideal 12 V-källa, resistorer på 2 Ω och 4 Ω. Ledningsresistansen försummas.",
    "instruktion": "+"
  },
  "ledtradar": [
    {
      "niva": "begrepp",
      "text": "I serie går samma ström genom båda resistorerna.",
      "status": "migrerad"
    },
    {
      "niva": "metod",
      "text": "Samla termerna med I, dela med den totala resistansen och räkna sedan ut spänningen över varje resistor.",
      "status": "migrerad"
    }
  ],
  "losning": {
    "text": "I = 12 V / 6 Ω = 2,0 A. U_{1} = 4 V, U_{2} = 8 V. Kontroll: 4 + 8 = 12 V.",
