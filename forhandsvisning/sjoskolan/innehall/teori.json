{
  "mal": {
    "LM-1": {
      "text": "Beskriva vanliga komponenter, skyddsutrustning och mätinstrument",
      "prov": "skriftligt",
      "kalla": "Kursens lärandemål, som i bokens inledning"
    },
    "LM-2": {
      "text": "Redogöra för elsäkerhet, risker och säkra arbetsrutiner i låg- och högspänningssystem",
      "prov": "skriftligt",
      "kalla": "Kursens lärandemål, som i bokens inledning"
    },
    "LM-3": {
      "text": "Tillämpa föreskrifter och standarder för mätteknik, skyddsutrustning och riskbedömning, med Transportstyrelsens föreskrifter i fokus",
      "prov": "skriftligt",
      "kalla": "Kursens lärandemål, som i bokens inledning"
    },
    "LM-4": {
      "text": "Utföra mätningar i likströms-, växelströms- och trefassystem",
      "prov": "skriftligt",
      "kalla": "Kursens lärandemål, som i bokens inledning"
    },
    "LM-5": {
      "text": "Genomföra felsökning med mätning och teknisk dokumentation",
      "prov": "skriftligt",
      "kalla": "Kursens lärandemål, som i bokens inledning"
    },
    "LM-6": {
      "text": "Tillämpa elsäkerhetsrutiner vid mätning, kontroll och felsökning",
      "prov": "praktiskt",
      "kalla": "Kursens lärandemål, som i bokens inledning"
    },
    "LM-7": {
      "text": "Ansvara för felsökning, riskbedömning och kvalitetssäkring enligt standarder och kontrollprotokoll",
      "prov": "praktiskt",
      "kalla": "Kursens lärandemål, som i bokens inledning"
    },
    "LM-8": {
      "text": "Analysera mätresultat och felsökningsunderlag",
      "prov": "praktiskt",
      "kalla": "Kursens lärandemål, som i bokens inledning"
    },
    "LM-9": {
      "text": "Ta ansvar för att arbetsmoment genomförs elsäkert, strukturerat och dokumenterat",
      "prov": "praktiskt",
      "kalla": "Kursens lärandemål, som i bokens inledning"
    }
  },
