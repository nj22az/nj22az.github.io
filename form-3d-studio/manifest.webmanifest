{
  "name": "Form 3D Studio",
  "short_name": "Form 3D",
  "description": "Private, offline 3D modelling for keychains and simple printable forms.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f5f5f7",
  "theme_color": "#f5f5f7",
  "categories": ["design", "productivity", "utilities"],
  "icons": [
    {
      "src": "form-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"],
        "image/svg+xml": [".svg"]
      }
    }
  ]
}
