{
  "name": "minato-farm",
  "version": "0.1.0",
  "private": true,
  "description": "Minato Farm: a farm simulator using Johansson World assets, wrapped for iOS with Capacitor.",
  "scripts": {
    "serve": "python3 -m http.server 8000 --directory www",
    "ios:add": "cap add ios",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
